# ---------------------------------------------------------------------------
# Lumina LMS — environment configuration
# Copy to `.env` and adjust. Every value below has a working default for local
# development except AUTH_SECRET, which you must generate.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default — zero setup, great for pilots and small orgs up to ~500 users)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production / multi-instance deployments).
# To switch: set `provider = "postgresql"` in prisma/schema.prisma, then:
#   npx prisma migrate dev
# DATABASE_URL="postgresql://lumina:lumina@localhost:5432/lumina?schema=public"

# --- Auth ------------------------------------------------------------------
# REQUIRED. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# How long a login session stays valid, in seconds. Default: 7 days.
AUTH_SESSION_MAX_AGE=604800

# Set to "true" to let anyone with a matching email domain self-register.
# Set to "false" to make accounts admin-provisioned only.
AUTH_ALLOW_SELF_REGISTRATION=true

# Restrict self-registration to these email domains (comma separated).
# Leave blank to allow any domain.
AUTH_ALLOWED_EMAIL_DOMAINS=""

# --- Single sign-on (OIDC) -------------------------------------------------
# Optional. Set all three and the login page grows a "Sign in with SSO" button;
# leave any of them blank and Lumina stays password-only. Works with Azure AD,
# Okta, Google Workspace, Keycloak, Auth0 — anything that publishes a discovery
# document at <issuer>/.well-known/openid-configuration.
#
# Register the redirect URI with your provider as:
#   https://<your-host>/api/auth/callback/oidc
# OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# Scopes requested from the provider. `openid` is required; `email` is what the
# account is matched on, and `profile` fills in the display name.
# OIDC_SCOPES="openid email profile"

# Create a Lumina account the first time someone signs in through the IdP.
# Defaults to false, which means an admin must provision people up front — the
# stricter posture, and the right one if the IdP covers more people than should
# have access here. When true, AUTH_ALLOWED_EMAIL_DOMAINS above still applies to
# the accounts it creates.
# OIDC_AUTO_PROVISION="false"

# Role given to auto-provisioned accounts: LEARNER (default), INSTRUCTOR, ADMIN.
# OIDC_DEFAULT_ROLE="LEARNER"

# Text on the login button. Worth setting to something people recognise.
# OIDC_BUTTON_LABEL="Sign in with SSO"

# Only needed when the derived callback URL is wrong — typically behind a proxy
# that rewrites the path, or when the public hostname differs from the one the
# app sees. Must match what is registered with the provider exactly.
# OIDC_REDIRECT_URI="https://lms.example.com/api/auth/callback/oidc"

# --- Storage ---------------------------------------------------------------
# Driver for course media. "local" writes to disk (default, zero dependencies).
# The driver interface lives in src/lib/storage/ — implement S3/Azure there.
STORAGE_DRIVER="local"

# Where the local driver writes files, relative to the project root.
STORAGE_LOCAL_DIR="./storage"

# Max upload size in megabytes.
STORAGE_MAX_UPLOAD_MB=512

# --- Branding --------------------------------------------------------------
# These override the defaults in lumina.config.ts without a code change.
NEXT_PUBLIC_APP_NAME="Lumina"
NEXT_PUBLIC_APP_TAGLINE="Learning, elevated."
NEXT_PUBLIC_ORG_NAME="Your Organization"

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"

# Port for `npm run dev` and `npm start`. Defaults to 4400 — deliberately not
# 3000, which collides with Next.js, CRA, and Rails defaults.
# If the chosen port is busy the launcher moves to the next free one and says so;
# pass --strict-port to fail instead. 3000 is excluded and will be redirected.
PORT=4400

# --- Seed ------------------------------------------------------------------
# Identity of the administrator created by `npm run db:seed`. Set these if you
# have changed the admin login, otherwise a reseed recreates the default admin as
# a second account alongside yours.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="Password123!"
