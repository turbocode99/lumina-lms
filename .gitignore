# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
# Dev uses a separate distDir so it cannot clobber a production build.
/.next-dev/
/out/
next-env.d.ts

# production
/build
/dist

# database (local SQLite)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db*
prisma/*.db*

# uploads — user content never belongs in git
/storage/
/public/uploads/

# env
.env
.env.local
.env*.local
.env.production
# Generated by deploy.sh — holds AUTH_SECRET and (if --postgres) a DB password.
.env.docker

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Written by up.bat / stop.bat — local runtime state, never something to commit.
.lumina.pid
lumina-server.log
lumina-server.err.log

# Generated sales/board collateral — regenerable, and a 9.5 MB binary in git
# history is permanent. Keep it out of the clone and the Docker build context.
Lumina_LMS_Presentation.pdf

# The brand film and its full-resolution stills, for the same reason: together
# they are ~100 MB of pure output. marketing/pipeline/ regenerates both from the
# committed script and the web-resolution stills, so nothing here is lost.
/marketing/*.mp4
/marketing/shots/

# typescript
*.tsbuildinfo

# editors
.vscode/
.idea/

# vercel
.vercel
