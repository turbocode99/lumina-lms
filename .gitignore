# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
# Dev uses a separate distDir so it cannot clobber a production build.
/.next-dev/
/out/
next-env.d.ts

# production
/build
/dist

# database (local SQLite)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db*
prisma/*.db*

# uploads — user content never belongs in git
/storage/
/public/uploads/

# env
.env
.env.local
.env*.local
.env.production
# Generated by deploy.sh — holds AUTH_SECRET and (if --postgres) a DB password.
.env.docker

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# editors
.vscode/
.idea/

# vercel
.vercel
